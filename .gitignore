# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python
__pycache__/
*.py[cod]

# WASM build stamps (mode / flags invalidation)
cpp/.wasm_mode
cpp/.wasm_flags
cpp/.wasm_flags.new

# Host-side C++ test binary (built by `npm run test:cpp`). Committing it is a
# trap: a fresh checkout gives the binary and its sources equal mtimes, so make
# considers it up to date and `make test` runs the stale binary instead of the
# tests in the working tree.
cpp/tests/test_engine
# Same trap, plus it is several times larger — the sanitizer build from
# `npm run test:cpp:asan`.
cpp/tests/test_engine_asan

# clangd database for the host C++ compile. Generated by
# `npm run compile-commands`; embeds an absolute `directory` path, so it is
# per-checkout rather than committed.
cpp/compile_commands.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
test-screenshots/
