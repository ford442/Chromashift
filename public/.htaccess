# Served from dist/ on the Apache hosts (deploy.py wipes the remote directory
# first, so this has to ship inside the build). #268
#
# This is the only host configuration the repo owns; nothing else here may rely
# on server settings it does not set itself.

# `/chromashift/` must serve the app, not an "Index of" listing.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  # Browsers refuse streaming WebAssembly compilation without application/wasm,
  # and strict module-worker loading wants a JavaScript MIME type.
  AddType application/wasm .wasm
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# The production page is cross-origin isolated (SharedArrayBuffer for the WASM
# engine and workers). `vite preview` sends the same three (vite.config.ts).
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>
