# Build-time variables for `vite build` (committed: nothing here is secret —
# every value is a public URL baked into the client bundle). #268
# `.env.local` / `.env.production.local` (gitignored) override these; so does an
# exported VITE_* variable. Documented in README.md ("Build-time variables").

# TF.js Real-ESRGAN / Real-CUGAN model trees (realesrgan/, realcugan/). Without
# it the default upscaler (realesrgan:general_plus) can only throw. Verified
# 2026-11-28: model.json and shards answer 200 with Access-Control-Allow-Origin: *
# and Cross-Origin-Resource-Policy: cross-origin, which the page's COEP needs.
VITE_UPSCALER_BASE=https://js.1ink.us

# waifu2x swin_unet ONNX models (models/swin_unet/, models/utils/). Same as the
# code's default, pinned here so the value a build ships is visible in the repo.
VITE_NUNIF_BASE=https://test.1ink.us/nunif

# onnxruntime-web runtime (ort-wasm-simd-threaded.{mjs,wasm}) is deliberately NOT
# pinned here. It must be the exact release of the bundled onnxruntime-web, so the
# worker derives it from the installed package version
# (https://cdn.jsdelivr.net/npm/onnxruntime-web@<version>/dist). A mirror hand-copied
# to test.1ink.us/nunif/ort in 2024 did not match 1.26.0 and broke every waifu2x
# upscale (#269). Set VITE_NUNIF_ORT_WASM_BASE only for a mirror kept in step.
