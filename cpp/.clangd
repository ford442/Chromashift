# clangd configuration for the C++ engine.
#
# Generate the database with `npm run compile-commands` (or
# `make -C cpp compile-commands`). It is gitignored because it embeds absolute
# paths. Its compilers and flags come straight from cpp/Makefile, so there is
# nothing to repeat here.
#
# With emsdk active ($EMSDK set, e.g. after `source emsdk_env.sh`), the engine's
# translation units are described as the wasm32 + -msimd128 compile emcc does,
# so clangd gives diagnostics inside the `#if CS_HAS_SIMD` blocks as well as the
# scalar tails that follow them. Without emsdk it falls back to the host (g++)
# compile, and those blocks grey out.
CompileFlags:
  CompilationDatabase: .

Diagnostics:
  UnusedIncludes: Strict
